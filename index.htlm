<!DOCTYPE html>

<html lang="tr">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<title>GT Proxy Panel</title>

<style>

*{box-sizing:border-box}

body{

 margin:0;background:#10131d;color:white;

 font-family:Arial,sans-serif;padding:22px

}

.panel{

 max-width:480px;margin:35px auto;

 background:#1b2030;padding:25px;

 border-radius:20px;border:1px solid #343d53

}

h1{color:#a78bfa;text-align:center}

p{color:#aab2c5}

.item{

 background:#292f43;padding:17px;

 border-radius:12px;margin:13px 0

}

.value{font-size:19px;font-weight:bold}

button{

 width:100%;padding:15px;border:0;

 border-radius:10px;background:#7955db;

 color:white;font-size:16px;margin-top:12px

}

small{color:#9ca3af}

</style>

</head>

<body>

<div class="panel">

<h1>⚡ GT PROXY</h1>

<p style="text-align:center">Personal Control Panel</p>

<div class="item">

<small>SERVER LOCATION</small>

<div class="value">🇪🇺 Europe</div>

</div>

<div class="item">

<small>SERVER STATUS</small>

<div class="value" id="status">Not Connected</div>

</div>

<div class="item">

<small>SERVER IP</small>

<div class="value">Not configured</div>

</div>

<div class="item">

<small>PROXY PORT</small>

<div class="value">Not configured</div>

</div>

<button onclick="alert('Henüz gerçek sunucu kurulmadı!')">

Server Settings

</button>

<p style="text-align:center">

<small>GT Proxy • Personal Dashboard</small>

</p>

</div>

</body>

</html>