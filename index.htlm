<!DOCTYPE html>

<html lang="tr">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>GT Proxy Panel</title>

  <style>

    body {

      margin: 0;

      padding: 30px 15px;

      background: #111827;

      color: white;

      font-family: Arial, sans-serif;

      text-align: center;

    }

    .panel {

      max-width: 400px;

      margin: 40px auto;

      padding: 25px;

      background: #1f2937;

      border-radius: 15px;

    }

    h1 { color: #38bdf8; }

    .status {

      color: #f87171;

      font-weight: bold;

    }

    button {

      padding: 12px 20px;

      margin-top: 15px;

      border: 0;

      border-radius: 8px;

      background: #0ea5e9;

      color: white;

      font-size: 16px;

    }

  </style>

</head>

<body>

  <div class="panel">

    <h1>GT Proxy Panel</h1>

    <p>Server Location: Europe</p>

    <p>Status: <span class="status">Not Connected</span></p>

    <p>IP: Not Configured</p>

    <p>Port: Not Configured</p>

    <button onclick="alert('Server settings')">

      Server Settings

    </button>

  </div>

</body>

</html>